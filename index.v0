<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Fuel Tracker Pro</title>
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --accent: #38bdf8;
      --accent-hover: #0284c7;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --border: #334155;
      --danger: #ef4444;
      --success: #10b981;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; -webkit-tap-highlight-color: transparent; }
    body { background-color: var(--bg); color: var(--text); padding: 16px; padding-bottom: 40px; max-width: 600px; margin: 0 auto; }
    header { text-align: center; padding: 12px 0 20px; }
    h1 { font-size: 1.5rem; font-weight: 700; color: var(--accent); }
    .card { background: var(--card); border-radius: 16px; padding: 18px; margin-bottom: 20px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3); border: 1px solid var(--border); }
    h2 { font-size: 1.1rem; margin-bottom: 14px; color: var(--text); border-bottom: 1px solid var(--border); padding-bottom: 8px; }
    .form-group { margin-bottom: 12px; }
    label { display: block; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 4px; }
    input { width: 100%; padding: 12px; border-radius: 10px; border: 1px solid var(--border); background: #0f172a; color: #fff; font-size: 1rem; outline: none; }
    input:focus { border-color: var(--accent); }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .btn { width: 100%; padding: 14px; border-radius: 10px; border: none; font-size: 1rem; font-weight: 600; cursor: pointer; transition: 0.2s; margin-top: 8px; }
    .btn-primary { background: var(--accent); color: #0f172a; }
    .btn-primary:active { background: var(--accent-hover); }
    .btn-secondary { background: #334155; color: #fff; margin-top: 10px; }
    .btn-danger { background: rgba(239, 68, 68, 0.2); color: var(--danger); border: 1px solid var(--danger); font-size: 0.8rem; padding: 6px 10px; width: auto; }
    .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 16px; }
    .stat-card { background: #0f172a; padding: 12px; border-radius: 10px; border: 1px solid var(--border); text-align: center; }
    .stat-value { font-size: 1.2rem; font-weight: 700; color: var(--accent); margin-top: 4px; }
    .stat-label { font-size: 0.75rem; color: var(--text-muted); }
    .history-item { background: #0f172a; padding: 12px; border-radius: 10px; margin-bottom: 8px; border: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
    .history-info div { margin-bottom: 2px; }
    .history-date { font-size: 0.8rem; color: var(--text-muted); }
    .history-main { font-weight: 600; }
    .history-sub { font-size: 0.8rem; color: var(--accent); }
    canvas { width: 100% !important; max-height: 220px; }
    .tabs { display: flex; gap: 8px; margin-bottom: 16px; }
    .tab { flex: 1; padding: 10px; text-align: center; background: var(--card); border-radius: 10px; border: 1px solid var(--border); color: var(--text-muted); font-size: 0.9rem; font-weight: 600; }
    .tab.active { background: var(--accent); color: #0f172a; border-color: var(--accent); }
  </style>
</head>
<body>

  <header>
    <h1>Fuel Tracker Pro</h1>
  </header>

  <div class="tabs">
    <div class="tab active" onclick="switchTab('insert')">Inserisci</div>
    <div class="tab" onclick="switchTab('stats')">Grafici</div>
    <div class="tab" onclick="switchTab('history')">Storico</div>
  </div>

  <!-- TAB INSERIMENTO -->
  <div id="tab-insert" class="tab-content">
    <div class="card">
      <h2>Nuovo Rifornimento</h2>
      <div class="form-group">
        <label>Data</label>
        <input type="date" id="date">
      </div>
      <div class="grid-2">
        <div class="form-group">
          <label>Prezzo/L (€)</label>
          <input type="number" id="price" step="0.001" placeholder="1.850" oninput="calculate('price')">
        </div>
        <div class="form-group">
          <label>Litri (L)</label>
          <input type="number" id="liters" step="0.01" placeholder="40.00" oninput="calculate('liters')">
        </div>
      </div>
      <div class="form-group">
        <label>Costo Totale (€)</label>
        <input type="number" id="total" step="0.01" placeholder="74.00" oninput="calculate('total')">
      </div>
      <div class="form-group">
        <label>Chilometri Totali Attuali (km)</label>
        <input type="number" id="km" step="1" placeholder="es. 125000">
      </div>
      <button class="btn btn-primary" onclick="saveRecord()">Salva Rifornimento</button>
    </div>
  </div>

  <!-- TAB GRAFICI & STATISTICHE -->
  <div id="tab-stats" class="tab-content" style="display:none;">
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Spesa Totale</div>
        <div class="stat-value" id="stat-total-spend">0 €</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Litri Totali</div>
        <div class="stat-value" id="stat-total-liters">0 L</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Consumo Medio</div>
        <div class="stat-value" id="stat-avg-consumption">0 km/L</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Prezzo Medio</div>
        <div class="stat-value" id="stat-avg-price">0 €/L</div>
      </div>
    </div>
    <div class="card">
      <h2>Andamento Prezzo/L</h2>
      <canvas id="chartPrice"></canvas>
    </div>
    <div class="card">
      <h2>Efficienza (km/L)</h2>
      <canvas id="chartEfficiency"></canvas>
    </div>
  </div>

  <!-- TAB STORICO & ESPORTA -->
  <div id="tab-history" class="tab-content" style="display:none;">
    <div class="card">
      <h2>Storico Rifornimenti</h2>
      <div id="history-list"></div>
      <button class="btn btn-secondary" onclick="exportCSV()">Esporta in CSV (Excel)</button>
    </div>
  </div>

<script>
  let records = JSON.parse(localStorage.getItem('fuel_records') || '[]');
  let chartP, chartE;

  document.getElementById('date').valueAsDate = new Date();

  function calculate(changedField) {
    let p = parseFloat(document.getElementById('price').value);
    let l = parseFloat(document.getElementById('liters').value);
    let t = parseFloat(document.getElementById('total').value);

    if (changedField === 'total' || changedField === 'price') {
      if (t && p) document.getElementById('liters').value = (t / p).toFixed(2);
    } else if (changedField === 'liters') {
      if (l && p) document.getElementById('total').value = (l * p).toFixed(2);
      else if (l && t) document.getElementById('price').value = (t / l).toFixed(3);
    }
  }

  function saveRecord() {
    let date = document.getElementById('date').value;
    let price = parseFloat(document.getElementById('price').value);
    let liters = parseFloat(document.getElementById('liters').value);
    let total = parseFloat(document.getElementById('total').value);
    let km = parseFloat(document.getElementById('km').value) || null;

    if (!date || !price || !liters || !total) {
      alert("Compila tutti i campi obbligatori!");
      return;
    }

    records.push({ date, price, liters, total, km, id: Date.now() });
    records.sort((a, b) => new Date(a.date) - new Date(b.date));
    localStorage.setItem('fuel_records', JSON.stringify(records));

    // Reset Form
    document.getElementById('price').value = '';
    document.getElementById('liters').value = '';
    document.getElementById('total').value = '';
    document.getElementById('km').value = '';
    
    alert("Salvato con successo!");
    render();
  }

  function deleteRecord(id) {
    if (confirm("Eliminare questo rifornimento?")) {
      records = records.filter(r => r.id !== id);
      localStorage.setItem('fuel_records', JSON.stringify(records));
      render();
    }
  }

  function switchTab(tabName) {
    document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
    document.getElementById(`tab-${tabName}`).style.display = 'block';
    event.target.classList.add('active');
    if (tabName === 'stats') updateCharts();
  }

  function render() {
    let list = document.getElementById('history-list');
    list.innerHTML = '';
    
    let totalSpend = 0, totalLiters = 0, totalKmDiff = 0, totalLitersForKm = 0;

    records.slice().reverse().forEach((r, idx) => {
      totalSpend += r.total;
      totalLiters += r.liters;

      // Calcolo Efficienza
      let originalIdx = records.length - 1 - idx;
      let effText = '';
      if (originalIdx > 0 && records[originalIdx].km && records[originalIdx - 1].km) {
        let dist = records[originalIdx].km - records[originalIdx - 1].km;
        let kmL = (dist / records[originalIdx].liters).toFixed(2);
        effText = ` | ${dist} km (${kmL} km/L)`;
        totalKmDiff += dist;
        totalLitersForKm += records[originalIdx].liters;
      }

      list.innerHTML += `
        <div class="history-item">
          <div class="history-info">
            <div class="history-main">${r.total.toFixed(2)} € (${r.liters.toFixed(2)} L)</div>
            <div class="history-sub">${r.price.toFixed(3)} €/L ${r.km ? ' - ' + r.km + ' km' : ''}${effText}</div>
            <div class="history-date">${r.date}</div>
          </div>
          <button class="btn btn-danger" onclick="deleteRecord(${r.id})">X</button>
        </div>
      `;
    });

    document.getElementById('stat-total-spend').innerText = totalSpend.toFixed(2) + ' €';
    document.getElementById('stat-total-liters').innerText = totalLiters.toFixed(1) + ' L';
    document.getElementById('stat-avg-price').innerText = records.length ? (totalSpend / totalLiters).toFixed(3) + ' €/L' : '0 €/L';
    
    if (totalLitersForKm > 0) {
      document.getElementById('stat-avg-consumption').innerText = (totalKmDiff / totalLitersForKm).toFixed(2) + ' km/L';
    }
  }

  function updateCharts() {
    let labels = records.map(r => r.date);
    let prices = records.map(r => r.price);
    
    let efficiencies = records.map((r, i) => {
      if (i > 0 && r.km && records[i-1].km) {
        return (r.km - records[i-1].km) / r.liters;
      }
      return null;
    });

    if (chartP) chartP.destroy();
    if (chartE) chartE.destroy();

    chartP = new Chart(document.getElementById('chartPrice'), {
      type: 'line',
      data: { labels, datasets: [{ label: 'Prezzo/L (€)', data: prices, borderColor: '#38bdf8', tension: 0.3 }] },
      options: { scales: { y: { grid: { color: '#334155' } } } }
    });

    chartE = new Chart(document.getElementById('chartEfficiency'), {
      type: 'line',
      data: { labels, datasets: [{ label: 'km / Litro', data: efficiencies, borderColor: '#10b981', tension: 0.3 }] },
      options: { scales: { y: { grid: { color: '#334155' } } } }
    });
  }

  function exportCSV() {
    let csv = "Data,Prezzo_Litro,Litri,Totale_Euro,Km_Totali\n";
    records.forEach(r => {
      csv += `${r.date},${r.price},${r.liters},${r.total},${r.km || ''}\n`;
    });
    let blob = new Blob([csv], { type: 'text/csv' });
    let a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `rifornimenti_${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
  }

  render();
</script>
</body>
</html>
